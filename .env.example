# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and the public anon / publishable key
# (Supabase dashboard → Project Settings → API). These are safe to expose to the
# browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL of the site, used for auth email redirect links.
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Not needed in Phase 1. If a future server-only feature needs the service-role key,
# add SUPABASE_SERVICE_ROLE_KEY here and only read it from server-only modules.
